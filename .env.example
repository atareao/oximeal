# Copia este fichero a `.env` y ajusta los valores.
# OxiMeal — configuración de entorno.

# --- Base de datos ---
# Ruta del fichero SQLite. El directorio debe existir.
DATABASE_URL=sqlite://data/oximeal.db

# --- Servidor ---
# Dirección de escucha HTTP.
BIND_ADDR=0.0.0.0:8080

# --- Observabilidad ---
# Filtro de logs de tracing (verbosidad).
RUST_LOG=info,oximeal_backend=debug

# --- Autenticación OIDC (Fase 4) ---
# Con OIDC_ENABLED=false la API queda ABIERTA, sin autenticación (solo desarrollo).
# Con OIDC_ENABLED=true son OBLIGATORIAS: OIDC_ISSUER, OIDC_CLIENT_ID,
# OIDC_CLIENT_SECRET, OIDC_API_AUDIENCE, OIDC_REDIRECT_URI,
# OIDC_POST_LOGOUT_REDIRECT_URI, OIDC_ALLOWED_GROUPS y SESSION_SECRET.
# El servidor falla al arrancar si falta alguna o si SESSION_SECRET es inseguro.
# Arranca igualmente aunque el IdP esté caído.

# Interruptor maestro. `true` activa el BFF OIDC (cookie de sesión + Bearer).
OIDC_ENABLED=false

# Issuer OIDC de Pocket ID (debe terminar el endpoint de descubrimiento en /.well-known).
# OBLIGATORIA con OIDC_ENABLED=true. Ejemplo dev local con deploy/compose.yaml:
OIDC_ISSUER=http://localhost:1411
# ID de cliente user-delegated (SPA/BFF) registrado en Pocket ID.
OIDC_CLIENT_ID=oximeal-spa
# Secreto del cliente confidencial BFF. NO versionar el valor real.
OIDC_CLIENT_SECRET=cambiame-cliente-secreto
# Resource/audiencia del API en Pocket ID (modelo "APIs and permissions").
OIDC_API_AUDIENCE=http://localhost:8080/api
# Redirect URI registrada en el cliente. Debe coincidir exactamente.
OIDC_REDIRECT_URI=http://localhost:8080/auth/callback
# Destino tras el logout (post_logout_redirect_uri).
OIDC_POST_LOGOUT_REDIRECT_URI=http://localhost:8080/
# Allowlist de grupos permitidos (CSV). Puerta de entrada: sin rol, solo acceso sí/no.
OIDC_ALLOWED_GROUPS=oximeal-users

# Orígenes CORS permitidos (CSV). Vacío ⇒ ninguno.
ALLOWED_ORIGINS=http://localhost:8080

# --- Importación de recetas ---
# Hosts exentos del veto de rango privado/loopback/link-local (CSV) en la
# importación desde URL. Vacío ⇒ estricto. Pensado para entornos de prueba
# locales; NO añadas hosts internos en producción.
IMPORT_ALLOWED_HOSTS=

# --- Sesión server-side (SQLite) ---
# Clave de firma/cifrado de la sesión. OBLIGATORIA con OIDC_ENABLED=true.
# Debe ser única y aleatoria; se rechazan valores por defecto conocidos.
# Genera una con: openssl rand -hex 32
SESSION_SECRET=cambiame-secreto-de-sesion-muy-largo-y-aleatorio
# Duración de la sesión en segundos (def. 2592000 = 30 días).
SESSION_TTL_SECS=2592000
# Margen de refresco del access token en segundos (def. 300 = 5 min).
SESSION_REFRESH_MARGIN_SECS=300
# Nombre de la cookie de sesión. El prefijo `__Host-` obliga a `Secure`,
# `Path=/` y sin `Domain` (recomendado). Cambiarlo invalida las sesiones vivas.
SESSION_COOKIE_NAME=__Host-oximeal_session
# Marca la cookie como Secure. En producción debe ser true (def. true).
# Con OIDC_ENABLED=true, `false` impide arrancar salvo ALLOW_INSECURE_COOKIE=true.
SESSION_COOKIE_SECURE=true
# Vida absoluta de la sesión en segundos desde el login (def. 43200 = 12 h).
# El refresco de tokens NO la extiende: pasado este tiempo hay que reautenticarse.
SESSION_ABSOLUTE_TTL_SECS=43200
# Escape explícito para aceptar una cookie sin Secure con OIDC activo.
# Solo desarrollo en localhost; NUNCA en producción.
ALLOW_INSECURE_COOKIE=false
