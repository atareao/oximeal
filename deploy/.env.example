# Example .env for Pocket ID development
# Copy this file to `deploy/.env` and adjust if needed.

# Encryption key for Pocket ID – must be at least 32 ASCII chars.
# The same key must be exported to `ENCRYPTION_KEY` inside the container.
# In production generate using: 
#   openssl rand -base64 32
#   # or use a more secure key‑management solution.
ENCRYPTION_KEY=local-dev-key-32-bytes-padding!!
