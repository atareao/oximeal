# Ejemplo de entorno para el despliegue de OxiMeal con contenedor.
# Copia este fichero a `deploy/.env` y ajusta los valores.
#
# Con OIDC_ENABLED=false (modo abierto, SOLO desarrollo) la API queda sin
# autenticacion. Con OIDC_ENABLED=true hay que rellenar el bloque OIDC y
# SESSION_SECRET, o el contenedor fallara al arrancar.

# --- Base de datos ---
# Ruta del fichero SQLite dentro del contenedor (relativa a WORKDIR /app).
# Persiste en el volumen `oximeal-data` montado en /app/data.
DATABASE_URL=sqlite://data/oximeal.db

# --- Servidor ---
BIND_ADDR=0.0.0.0:8080

# --- Observabilidad ---
RUST_LOG=info

# --- Autenticacion OIDC ---
OIDC_ENABLED=false
OIDC_ISSUER=http://localhost:1411
OIDC_CLIENT_ID=oximeal-spa
OIDC_CLIENT_SECRET=cambiame-cliente-secreto
OIDC_API_AUDIENCE=http://localhost:8080/api
OIDC_REDIRECT_URI=http://localhost:8080/auth/callback
OIDC_POST_LOGOUT_REDIRECT_URI=http://localhost:8080/
OIDC_ALLOWED_GROUPS=oximeal-users

# --- CORS ---
ALLOWED_ORIGINS=http://localhost:8080

# --- Importacion de recetas ---
IMPORT_ALLOWED_HOSTS=

# --- Sesion server-side (SQLite) ---
# OBLIGATORIA con OIDC_ENABLED=true. Genera con: openssl rand -hex 32
SESSION_SECRET=
SESSION_TTL_SECS=2592000
SESSION_REFRESH_MARGIN_SECS=300
# El prefijo `__Host-` obliga a Secure, Path=/ y sin Domain (recomendado).
SESSION_COOKIE_NAME=__Host-oximeal_session
SESSION_COOKIE_SECURE=true
# Vida absoluta de la sesion desde el login (def. 43200 = 12 h).
SESSION_ABSOLUTE_TTL_SECS=43200
# Escape explicito para cookie sin Secure con OIDC activo (solo localhost).
ALLOW_INSECURE_COOKIE=false

